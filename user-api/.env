# Configurações do Quarkus
QUARKUS_HTTP_PORT=8093
QUARKUS_PROFILE=dev
QUARKUS_APP_NAME=orchestrator_app

# Configurações do Banco de Dados
QUARKUS_DATASOURCE_KIND=postgresql
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5437/payment_db_dev
QUARKUS_DATASOURCE_USERNAME=payment_user_dev
QUARKUS_DATASOURCE_PASSWORD=payment_pass_dev
